{
  "name": "hackernews-modern-ui",
  "description": "manifest.json description",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:all": "bun runn zip && bun run zip:firefox",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "resize": "bunx @kunver/resize",
    "manager": "bun manager.cjs bun"
  },
  "devDependencies": {
    "@wxt-dev/i18n": "0.2.7",
    "@wxt-dev/module-solid": "^1.1.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  },
  "trustedDependencies": [
    "spawn-sync"
  ]
}
