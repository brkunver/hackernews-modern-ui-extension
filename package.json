{
  "name": "hackernews-modern-ui",
  "description": "Hackernews Modern UI Extension",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:all": "bun run zip && bun run zip:firefox",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare",
    "resize": "bunx @kunver/resize",
    "screenshots": "bun scripts/capture-store-screenshots.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests/unit",
    "test:e2e": "bun run build && playwright test"
  },
  "dependencies": {
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@wxt-dev/i18n": "0.2.7",
    "@wxt-dev/module-solid": "^1.1.4",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "wxt": "^0.21.4"
  }
}
